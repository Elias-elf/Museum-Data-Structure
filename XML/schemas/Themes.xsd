<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name='Themes'>
		<xs:complexType>
			<xs:sequence>
				<xs:element name='Theme' minOccurs='1' maxOccurs='unbounded'>
					<xs:complexType>
						<xs:sequence>
							<xs:element name='CulturalHeritage' type='xs:string'/>
							<xs:element name='Description' type='xs:string'/>
						</xs:sequence>
						<xs:attribute name="id" type='xs:ID' use='required'/>
						<!--Each Theme has a unique ID, used as a reference by other Museum elements-->
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
