{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "Artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "Description": { "type": "string" },
          "Materials": {
            "type": "array",
            "items": { "type": "string" }
          },
          "Cultural_Heritage_Ref": { "type": "string" },
          "Under_Restoration": { "type": "string" }
        },
        "required": ["id", "Description", "Materials", "Cultural_Heritage_Ref", "Under_Restoration"]
      }
    }
  },
  "required": ["Artifacts"]
}