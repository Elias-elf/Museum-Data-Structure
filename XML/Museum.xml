	<Artifacts>
		<!-- 1. Egyptian Antiquities -->
		<Artifact id="ART001">
			<Description>
                A carved limestone funerary statue depicting an ancient Egyptian official.
            </Description>
			<Material>Stone</Material>
			<Collection ref="COL001"/>
			<Provenance>
                Excavated near Saqqara, Egypt, during archaeological investigations in 1905.
            </Provenance>
			<CulturalHeritage>
                Ancient Egyptian
            </CulturalHeritage>
			<HistoricalPeriod>05th century BC</HistoricalPeriod>
			<RestorationHistory restored="true">
				<Restoration_Nbre>1</Restoration_Nbre>
				<Last_Restoration_Description>
                    Surface cleaning and limestone stabilization.
                </Last_Restoration_Description>
			</RestorationHistory>
		</Artifact>
		<!-- 2. Roman Coins -->
		<Artifact id="ART002">
			<Description>
                A silver denarius depicting Emperor Augustus with imperial symbols.
            </Description>
			<Material>Silver</Material>
			<Collection ref="COL002"/>
			<Provenance>
                Found in a Roman archaeological site near Rome, Italy.
            </Provenance>
			<CulturalHeritage>
                Roman Empire
            </CulturalHeritage>
			<HistoricalDate>
                0010-01-01
            </HistoricalDate>
		</Artifact>
		<!-- 3. Greek Sculpture -->
		<Artifact id="ART003">
			<Description>
                A marble statue representing a standing youthful athlete.
            </Description>
			<Material>Marble</Material>
			<Collection ref="COL003"/>
			<Provenance>
                Discovered during excavations on the Greek mainland.
            </Provenance>
			<CulturalHeritage>
                Classical Greece
            </CulturalHeritage>
			<HistoricalPeriod>04th century BC</HistoricalPeriod>
			<RestorationHistory restored="true">
				<Restoration_Nbre>2</Restoration_Nbre>
				<Last_Restoration_Description>
                    Reconstruction of damaged marble fragments.
                </Last_Restoration_Description>
			</RestorationHistory>
		</Artifact>
		<!-- 4. Prehistoric Artifacts -->
		<Artifact id="ART004">
			<Description>
                A polished stone axe used by prehistoric communities.
            </Description>
			<Material>Stone</Material>
			<Collection ref="COL004"/>
			<Provenance>
                Discovered in a prehistoric settlement in Western Europe.
            </Provenance>
			<CulturalHeritage>
                Neolithic Culture
            </CulturalHeritage>
			<HistoricalPeriod>05th century BC</HistoricalPeriod>
		</Artifact>
		<!-- 5. Medieval Manuscripts -->
		<Artifact id="ART005">
			<Description>
                An illuminated manuscript containing religious texts written on parchment.
            </Description>
			<Material>Gold</Material>
			<Material>Wood</Material>
			<Collection ref="COL005"/>
			<Provenance>
                Preserved in a medieval monastery before entering the museum collection.
            </Provenance>
			<CulturalHeritage>
                Medieval European Christianity
            </CulturalHeritage>
			<HistoricalPeriod>12th century AD</HistoricalPeriod>
			<RestorationHistory restored="true">
				<Restoration_Nbre>1</Restoration_Nbre>
				<Last_Restoration_Description>
                    Manuscript pages were conserved and rebound.
                </Last_Restoration_Description>
			</RestorationHistory>
		</Artifact>
		<!-- 6. Renaissance Paintings -->
		<Artifact id="ART006">
			<Description>
                An oil painting depicting a Renaissance religious scene.
            </Description>
			<Material>Wood</Material>
			<Collection ref="COL006"/>
			<Provenance>
                Created in Florence and acquired by the museum in the 19th century.
            </Provenance>
			<CulturalHeritage>
                Italian Renaissance
            </CulturalHeritage>
			<HistoricalPeriod>15th century AD</HistoricalPeriod>
		</Artifact>
		<!-- 7. Islamic Art -->
		<Artifact id="ART007">
			<Description>
                A decorated bronze astrolabe used for astronomical calculations.
            </Description>
			<Material>Bronze</Material>
			<Collection ref="COL007"/>
			<Provenance>
                Produced in the medieval Islamic world and acquired through trade.
            </Provenance>
			<CulturalHeritage>
                Islamic Golden Age
            </CulturalHeritage>
			<HistoricalPeriod>10th century AD</HistoricalPeriod>
			<RestorationHistory restored="false">
				<Restoration_Nbre>0</Restoration_Nbre>
			</RestorationHistory>
		</Artifact>
		<!-- 8. Asian Ceramics -->
		<Artifact id="ART008">
			<Description>
                A blue and white porcelain vase decorated with floral motifs.
            </Description>
			<Material>Ceramic</Material>
			<Collection ref="COL008"/>
			<Provenance>
                Produced in China and exported through historical trade routes.
            </Provenance>
			<CulturalHeritage>
                Chinese Imperial Culture
            </CulturalHeritage>
			<HistoricalPeriod>15th century AD</HistoricalPeriod>
		</Artifact>
		<!-- 9. African Tribal Art -->
		<Artifact id="ART009">
			<Description>
                A carved wooden ceremonial mask used in traditional rituals.
            </Description>
			<Material>Wood</Material>
			<Collection ref="COL009"/>
			<Provenance>
                Collected in West Africa during an early 20th century expedition.
            </Provenance>
			<CulturalHeritage>
                West African Traditional Culture
            </CulturalHeritage>
			<HistoricalPeriod>20th century AD</HistoricalPeriod>
		</Artifact>
		<!-- 10. Natural History Specimens -->
		<Artifact id="ART010">
			<Description>
                A preserved mineral specimen collected during a geological expedition.
            </Description>
			<Material>Stone</Material>
			<Collection ref="COL010"/>
			<Provenance>
                Collected from a geological site and transferred to the museum archive.
            </Provenance>
			<CulturalHeritage>
                Natural History Collection
            </CulturalHeritage>
			<HistoricalDate>
                2020-01-01
            </HistoricalDate>
			<RestorationHistory restored="false">
				<Restoration_Nbre>0</Restoration_Nbre>
			</RestorationHistory>
		</Artifact>
		<Artifact id="ART012">
			<Description>
            A granodiorite stele inscribed with the same decree written in 
            Ancient Egyptian hieroglyphs, Demotic script, and Ancient Greek.
        </Description>
			<Material>Stone</Material>
			<Collection ref="COL001"/>
			<Provenance>
            Discovered in 1799 near Rosetta (Rashid), Egypt, during Napoleon's expedition.
            Acquired by the British Museum in 1802.
        </Provenance>
			<CulturalHeritage>
            Ancient Egyptian
        </CulturalHeritage>
			<CulturalHeritage>
            Ptolemaic Kingdom
        </CulturalHeritage>
			<HistoricalDate>1799-01-01</HistoricalDate>
			<RestorationHistory restored="true">
				<Restoration_Nbre>1</Restoration_Nbre>
				<Last_Restoration_Description>
                Surface cleaning and conservation treatment performed by museum conservators.
            </Last_Restoration_Description>
			</RestorationHistory>
		</Artifact>
		<Artifact id="ART013">
			<Description>
			A small bronze ceremonial falcon figurine depicting a mythical guardian 
			associated with protection rituals.
			</Description>
			<Material>Bronze</Material>
			<Collection ref="COL003"/>
			<Provenance>
			Excavated in a fictional archaeological site near the ancient city of Astarion.
			Entered the museum collection in 1924.
			</Provenance>
			<CulturalHeritage>
				Anatolian Bronze Culture
			</CulturalHeritage>
			<HistoricalPeriod>05th century BC</HistoricalPeriod>
			<RestorationHistory restored="true">
				<Restoration_Nbre>2</Restoration_Nbre>
				<Last_Restoration_Description>
				Removal of corrosion products and stabilization of bronze surface.
				</Last_Restoration_Description>
			</RestorationHistory>
		</Artifact>
	</Artifacts>
