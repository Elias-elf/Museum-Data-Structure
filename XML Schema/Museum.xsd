<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="Museum">
		<xs:complexType>
			<xs:sequence>
				<xs:element name='Collections'>
					<xs:complexType>
						<xs:sequence>
							<xs:element name='CollectionDefinition' minOccurs='1' maxOccurs='unbounded'>
								<xs:complexType>
									<xs:sequence>
										<xs:element name='Name' type='xs:string'/>
									</xs:sequence>
									<xs:attribute name="id" type='xs:ID' use='required'/>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name='Artifacts'>
					<xs:complexType>
						<xs:sequence>
							<xs:element name='Artifact' type='ArtifactType' minOccurs='1' maxOccurs='unbounded'/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element ref="Restoration"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Collection" type="CollectionType"/>
	<xs:element name="RestorationHistory" type="RestorationHistoryType"/>
	<xs:complexType name="ArtifactType">
		<xs:sequence>
			<xs:element name='Description' type='xs:string'/>
			<xs:element name='Material' minOccurs='1' maxOccurs='unbounded'>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Stone"/>
						<xs:enumeration value="Marble"/>
						<xs:enumeration value="Bronze"/>
						<xs:enumeration value="Gold"/>
						<xs:enumeration value="Silver"/>
						<xs:enumeration value="Wood"/>
						<xs:enumeration value="Ceramic"/>
						<xs:enumeration value="Glass"/>
						<xs:enumeration value="Iron"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element ref='Collection' minOccurs='1' maxOccurs='unbounded'/>
			<xs:element name='Provenance' type='xs:string'/>
			<xs:element name='CulturalHeritage' type='xs:string' minOccurs='0' maxOccurs='unbounded'/>
			<xs:choice>
				<xs:element name='HistoricalPeriod' minOccurs='0'>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[0-9][0-9]*(st|nd|rd|th) century (BC|AD)"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name='HistoricalDate' type='xs:date'/>
			</xs:choice>
			<xs:element ref='RestorationHistory' minOccurs='0' maxOccurs='unbounded'/>
		</xs:sequence>
		<xs:attribute name='id' type='xs:ID' use='required'/>
	</xs:complexType>
	<xs:complexType name='CollectionType'>
		<xs:attribute name="ref" type='xs:IDREF' use='optional'/>
	</xs:complexType>
	<xs:complexType name='RestorationHistoryType'>
		<xs:sequence>
			<xs:element name="Restoration_Nbre" type='xs:nonNegativeInteger'/>
			<xs:element name="Last_Restoration_Description" type='xs:string' minOccurs='0'/>
		</xs:sequence>
		<xs:attribute name="restored" type="xs:boolean" use='required'/>
	</xs:complexType>
	<!-- ===== RESTORATION SIDE ===== -->
	<xs:element name="Restoration" type="RestorationType"/>
	<xs:element name="Project" type="ProjectType"/>
	<xs:element name="Member" type="MemberType"/>
	<xs:complexType name="RestorationType">
		<xs:sequence>
			<xs:element ref="Project" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Team" type="TeamType"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProjectType">
		<xs:sequence>
			<xs:element name="Loan">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:positiveInteger">
							<xs:attribute name="currency" type="xs:string" use="required"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="Collection_Artifacts">
				<xs:complexType>
					<xs:sequence>
						<xs:element ref="Collection" minOccurs="0"/>
						<xs:element name="Artifact" minOccurs="0">
							<xs:complexType>
								<xs:attribute name="ref" type="xs:IDREF" use="required"/>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="type" use="required">
						<xs:simpleType>
							<xs:restriction base="xs:string">
								<xs:enumeration value="Collection"/>
								<xs:enumeration value="Artifact"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
				</xs:complexType>
			</xs:element>
			<xs:element name="ResponsibleRef">
				<xs:complexType>
					<xs:attribute name="ref" type="xs:IDREF" use="required"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="id" type="xs:ID" use="required"/>
	</xs:complexType>
	<xs:complexType name="TeamType">
		<xs:sequence>
			<xs:element ref="Member" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MemberType">
		<xs:sequence>
			<xs:element name="Name" type="xs:string"/>
			<xs:element name="LastName" type="xs:string"/>
			<xs:element name="Role" type="xs:string"/>
			<xs:element name="Department" type="xs:string"/>
		</xs:sequence>
		<xs:attribute name="id" type="xs:ID" use="required"/>
	</xs:complexType>
</xs:schema>