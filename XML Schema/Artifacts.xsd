<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="Museum">
		<xs:complexType>
			<xs:sequence>
				<xs:element name='Collections'>
					<xs:complexType>
						<xs:sequence>
							<xs:element name='CollectionDefinition' minOccurs='1' maxOccurs='unbounded'>
								<xs:complexType>
									<xs:sequence>
										<xs:element name='Name' type='xs:string'/>
									</xs:sequence>
									<xs:attribute name="id" type='xs:ID' use='required'/>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name='Artifacts'>
					<xs:complexType>
						<xs:sequence>
							<xs:element name='Artifact' type='ArtifactType' minOccurs='1' maxOccurs='unbounded'/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Collection" type="CollectionType"/>
	<xs:element name="RestorationHistory" type="RestorationHistoryType"/>
	<xs:complexType name="ArtifactType">
		<xs:sequence>
			<xs:element name='Description' type='xs:string'/>
			<xs:element name='Material' minOccurs='1' maxOccurs='unbounded'>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Stone"/>
						<xs:enumeration value="Marble"/>
						<xs:enumeration value="Bronze"/>
						<xs:enumeration value="Gold"/>
						<xs:enumeration value="Silver"/>
						<xs:enumeration value="Wood"/>
						<xs:enumeration value="Ceramic"/>
						<xs:enumeration value="Glass"/>
						<xs:enumeration value="Iron"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element ref='Collection' minOccurs='1' maxOccurs='unbounded'/>
			<xs:element name='Provenance' type='xs:string'/>
			<xs:element name='CulturalHeritage' type='xs:string' minOccurs='0' maxOccurs='unbounded'/>
			<xs:choice>
				<xs:element name='HistoricalPeriod' minOccurs='0'>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[0-9][0-9]*(st|nd|rd|th) century (BC|AD)"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name='HistoricalDate' type='xs:date'/>
			</xs:choice>
			<xs:element ref='RestorationHistory' minOccurs='0' maxOccurs='unbounded'/>
		</xs:sequence>
		<xs:attribute name='id' type='xs:ID' use='required'/>
	</xs:complexType>
	<xs:complexType name='CollectionType'>
		<xs:attribute name="ref" type='xs:IDREF' use='optional'/>
	</xs:complexType>
	<xs:complexType name='RestorationHistoryType'>
		<xs:sequence>
			<xs:element name="Restoration_Nbre" type='xs:nonNegativeInteger'/>
			<xs:element name="Last_Restoration_Description" type='xs:string' minOccurs='0'/>
		</xs:sequence>
		<xs:attribute name="restored" type="xs:boolean" use='required'/>
	</xs:complexType>
</xs:schema>
